RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^smartwandler\.de$ [NC]
RewriteRule ^(.*)$ https://www.smartwandler.de/$1 [R=301,L]

# ─────────────────────────────────────────
# Clean URLs für Landingpages (ohne .html-Endung)
# ─────────────────────────────────────────
# 1) Wenn jemand /<slug>.html aufruft → 301-Redirect auf /<slug>
RewriteCond %{THE_REQUEST} \s/+ingenieurbueros\.html[\s?] [NC]
RewriteRule ^ /ingenieurbueros [R=301,L]

RewriteCond %{THE_REQUEST} \s/+blog\.html[\s?] [NC]
RewriteRule ^ /blog [R=301,L]

RewriteCond %{THE_REQUEST} \s/+blog-lokale-ki\.html[\s?] [NC]
RewriteRule ^ /blog/lokale-ki [R=301,L]

RewriteCond %{THE_REQUEST} \s/+maschinenbau\.html[\s?] [NC]
RewriteRule ^ /maschinenbau [R=301,L]

RewriteCond %{THE_REQUEST} \s/+wissen-geht-in-rente\.html[\s?] [NC]
RewriteRule ^ /wissen-geht-in-rente [R=301,L]

# 2) Intern /<slug> → /<slug>.html ausliefern (URL bleibt sauber)
RewriteRule ^blog/?$ blog.html [L]
RewriteRule ^blog/lokale-ki/?$ blog-lokale-ki.html [L]
RewriteRule ^ingenieurbueros/?$ ingenieurbueros.html [L]
RewriteRule ^maschinenbau/?$ maschinenbau.html [L]
RewriteRule ^wissen-geht-in-rente/?$ wissen-geht-in-rente.html [L]

# ─────────────────────────────────────────
# Eingestellte Landingpages → Startseite (301)
# Seiten entfernt; Slugs bleiben als Redirect bestehen, damit alte
# Links, Anzeigen und Suchergebnisse nicht ins Leere laufen.
# ─────────────────────────────────────────
RewriteRule ^lokale-ki(\.html)?/?$ / [R=301,L]
RewriteRule ^meeting-transkription(\.html)?/?$ / [R=301,L]
RewriteRule ^voicemail(\.html)?/?$ / [R=301,L]

# ─────────────────────────────────────────
# MIME-Types (sicherstellen, dass WebP/WOFF2 korrekt ausgeliefert werden)
# ─────────────────────────────────────────
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType text/css .css
  AddType application/javascript .js
</IfModule>

# ─────────────────────────────────────────
# Caching (Cache-Control via mod_headers + Expires-Fallback)
# ─────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML kurz cachen, damit Inhaltsänderungen schnell durchschlagen
  ExpiresByType text/html "access plus 1 hour"

  # Statische Assets ein Jahr cachen (immutable — Cache-Busting siehe unten)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Statische Dateien: 1 Jahr + immutable.
  # ACHTUNG: "immutable" heisst, Browser revalidieren NIE — auch nicht beim Reload.
  # Nach jeder Aenderung an styles.css oder script.js MUSS deshalb der ?v=-Parameter
  # in allen HTML-Dateien hochgezaehlt werden, sonst sehen wiederkehrende Besucher
  # dauerhaft die alte Datei:
  #   grep -rl 'styles.css?v=' --include='*.html' . | xargs perl -pi -e 's/\?v=\d{8}/?v=JJJJMMTT/g'
  <FilesMatch "\.(css|js|png|jpe?g|webp|avif|svg|ico|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML: 1 Stunde, muss revalidiert werden
  <FilesMatch "\.html?$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# ─────────────────────────────────────────
# Kompression
# ─────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml font/woff2
</IfModule>
